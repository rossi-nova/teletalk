# teletalk 网关配置
# 绝大多数情况下留空即可：网关启动时会自动拉起钉钉、从进程内存抓取登录态。

# 端口
PORT=8787

# 钉钉端点
DT_HOST=tls-desktop.dingtalk.com

# 自动关闭钉钉（避免多客户端互踢）。默认 1（开）；设为 0 则只提示不关闭。
# 流程：抓取凭据 → /reg 验证 → 验证成功才关钉钉 → 用已验证凭据重连。
DT_AUTO_CLOSE=1

# 以下通常不需要填写，仅作覆盖/调试用
# DT_DEVICE_ID=
# DT_TOKEN=
# DT_APP_KEY=564ca050be89b14ee78d692f6ded748d
# DT_APPKEY=85A09F60A599F5E1867EAB915A8BB07G
# DT_ORG_ID=
